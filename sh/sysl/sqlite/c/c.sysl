module sh.sysl.sqlite.c
@link("sqlite3")
@include("<sqlite3.h>")

// SQLite as C declares it, and nothing else.
//
// This is the whole of the boundary: the library the program links, the header the constants are
// measured from, the two handles whose shape SQLite never publishes, its result codes, and one
// `extern` per function. The module above -- `sh.sysl.sqlite` -- is where those turn into something
// worth calling, and it is the only importer this file expects. Nothing stops a program importing
// this one, and a program reaching for a corner of SQLite the layer above has not bound yet is
// exactly who should.
//
// **The library is named once, here** (`15 §8`). A program that depends on this package says nothing
// about linking; the requirement travels in the artifact. The header is likewise named once, and the
// `c const` block below is measured from whatever it says on the machine being built for -- which is
// the whole reason the numbers are not written down.
//
// SQLite is a good library to see this shape on, because almost nothing crosses the boundary that is
// not a pointer or an integer: no struct is laid out, no callback is installed, and there are no
// varargs. What does cross is two handles and a `#define` that is not a value at all, and both have
// somewhere of their own to go.

// The database connection, and a prepared statement. Both are C's incomplete types -- `sqlite3` and
// `sqlite3_stmt` are declared and never defined in the header, so a size was never on offer. Written
// bodyless here, which says exactly that (`15 §9`): only `*Sqlite3` and `*Stmt` may be spoken, and
// neither can be crossed with the other or with the `*u8` strings declared beside them.
opaque struct Sqlite3
opaque struct Stmt

// The flags `open` takes, as the header spells them.
//
// **Creating the file is a separate bit from opening it for writing**, which is the distinction the
// layer above turns into `Access`. A binding that or'd the two together once and offered nothing else
// -- which this one did until the flags stopped being hard-coded -- cannot open an existing database
// for writing and fail when it is not there.
c const
    OPEN_READONLY: int  = "SQLITE_OPEN_READONLY"
    OPEN_READWRITE: int = "SQLITE_OPEN_READWRITE"
    OPEN_CREATE: int    = "SQLITE_OPEN_CREATE"

// SQLite's primary result codes, read from the header of the machine being built for.
//
// They are `#define`s, so there is no symbol for an `extern` to name -- and until sysl could ask the
// C compiler for a value, the way to reach one was a function returning it, which meant every
// comparison was a call. A constant is what they always were: `ROW` may stand in a `match` arm and be
// folded into a comparison, and neither is something `c_row()` could ever have done.
//
// The whole list is here rather than the three the binding used to compare against, because `Code`
// above turns them into names a caller can `match` on -- and `BUSY` in particular is the difference
// between a program that retries and one that reports "database is locked" to somebody who cannot
// act on it.
c const
    OK: int         = "SQLITE_OK"
    ERROR: int      = "SQLITE_ERROR"
    INTERNAL: int   = "SQLITE_INTERNAL"
    PERM: int       = "SQLITE_PERM"
    ABORT: int      = "SQLITE_ABORT"
    BUSY: int       = "SQLITE_BUSY"
    LOCKED: int     = "SQLITE_LOCKED"
    NOMEM: int      = "SQLITE_NOMEM"
    READONLY: int   = "SQLITE_READONLY"
    INTERRUPT: int  = "SQLITE_INTERRUPT"
    IOERR: int      = "SQLITE_IOERR"
    CORRUPT: int    = "SQLITE_CORRUPT"
    NOTFOUND: int   = "SQLITE_NOTFOUND"
    FULL: int       = "SQLITE_FULL"
    CANTOPEN: int   = "SQLITE_CANTOPEN"
    PROTOCOL: int   = "SQLITE_PROTOCOL"
    EMPTY: int      = "SQLITE_EMPTY"
    SCHEMA: int     = "SQLITE_SCHEMA"
    TOOBIG: int     = "SQLITE_TOOBIG"
    CONSTRAINT: int = "SQLITE_CONSTRAINT"
    MISMATCH: int   = "SQLITE_MISMATCH"
    MISUSE: int     = "SQLITE_MISUSE"
    NOLFS: int      = "SQLITE_NOLFS"
    AUTH: int       = "SQLITE_AUTH"
    FORMAT: int     = "SQLITE_FORMAT"
    RANGE: int      = "SQLITE_RANGE"
    NOTADB: int     = "SQLITE_NOTADB"
    NOTICE: int     = "SQLITE_NOTICE"
    WARNING: int    = "SQLITE_WARNING"
    ROW: int        = "SQLITE_ROW"
    DONE: int       = "SQLITE_DONE"

// What `sqlite3_column_type` answers: the storage class of the value this column of this row is
// actually holding.
//
// **A storage class belongs to the value and not to the column**, which is the thing to know before
// reading one. A column's declared type is an affinity rather than a promise, so a column declared
// `INTEGER` hands back a `TEXT` value where text was stored -- and a reader that wants to know what it
// is holding asks this rather than the schema.
//
// `SQLITE_NULL` is spelled `NULL_TYPE` here because a reader meeting `NULL` beside a file full of
// pointers would take it for one. It is the number 5.
c const
    INTEGER: int   = "SQLITE_INTEGER"
    FLOAT: int     = "SQLITE_FLOAT"
    TEXT: int      = "SQLITE_TEXT"
    BLOB: int      = "SQLITE_BLOB"
    NULL_TYPE: int = "SQLITE_NULL"

// Opening and closing a connection, and the message the connection is carrying.
//
// `errmsg` answers "out of memory" when it is handed a null connection, which is SQLite's own
// arrangement and is what makes the failing path of `open` safe to write without a null check: an
// open that failed for want of memory is the one case where there is no handle to ask.
extern "sqlite3_open_v2" open(path: *u8, db: **Sqlite3, flags: int, vfs: *u8) -> int
extern "sqlite3_close" close(db: *Sqlite3) -> int
extern "sqlite3_errmsg" errmsg(db: *Sqlite3) -> *u8

// What the connection itself has to say afterwards: the key the last insert was given, how many rows
// the last statement touched, how long to wait on a lock before giving up, and whether a transaction
// is open.
//
// A rowid is 64 bits, so it is a `long` rather than an `int` -- SQLite's own `sqlite3_int64`. `changes`
// is an `int` because SQLite declares it as one; the 64-bit `sqlite3_changes64` is a newer symbol and
// is deliberately not named here, since a statement touching more than two billion rows is not a case
// this binding is buying a compatibility floor for.
//
// `get_autocommit` answers non-zero when the connection is in autocommit mode, which is to say when no
// transaction is open -- so it reads inverted, and the layer above is where that is turned the right
// way round.
extern "sqlite3_last_insert_rowid" last_insert_rowid(db: *Sqlite3) -> long
extern "sqlite3_changes" changes(db: *Sqlite3) -> int
extern "sqlite3_busy_timeout" busy_timeout(db: *Sqlite3, ms: int) -> int
extern "sqlite3_get_autocommit" get_autocommit(db: *Sqlite3) -> int

// Whether this SQLite was built with a named option -- `"ENABLE_FTS5"`, `"THREADSAFE=1"`. The
// `SQLITE_` prefix is optional and both spellings answer the same thing, which `tests.sysl` checks
// rather than takes on trust.
extern "sqlite3_compileoption_used" compileoption_used(name: *u8) -> int

// Compiling a statement, running it, and releasing it. `prepare`'s last parameter is where SQLite
// writes a pointer to whatever text is left over, which is the only way to reach the second statement
// in one string.
extern "sqlite3_prepare_v2" prepare(db: *Sqlite3, sql: *u8, n: int, stmt: **Stmt, tail: **u8) -> int
extern "sqlite3_step" step(stmt: *Stmt) -> int
extern "sqlite3_finalize" finalize(stmt: *Stmt) -> int
extern "sqlite3_reset" reset(stmt: *Stmt) -> int

// Reading the current row. The bytes `column_text`, `column_blob` and `column_name` answer are
// SQLite's own and stay valid only until the next step, so a caller copies them out rather than
// keeping the pointer.
//
// **`column_bytes` is asked AFTER `column_blob`, not before**, and this is SQLite's own rule rather
// than a preference. Either call may convert the value in place -- reading a number as a blob makes
// its text -- and the length is only the length of what the *last* call produced. Asking for the size
// first and the bytes second can therefore answer the size of something else.
//
// `column_decltype` answers the type the CREATE TABLE wrote for this column, and null for a column
// that is an expression rather than a table's -- `SELECT count(*)` has no declared type because there
// is no declaration to read.
extern "sqlite3_column_count" column_count(stmt: *Stmt) -> int
extern "sqlite3_column_type" column_type(stmt: *Stmt, col: int) -> int
extern "sqlite3_column_int" column_int(stmt: *Stmt, col: int) -> int
extern "sqlite3_column_int64" column_int64(stmt: *Stmt, col: int) -> long
extern "sqlite3_column_double" column_double(stmt: *Stmt, col: int) -> real
extern "sqlite3_column_text" column_text(stmt: *Stmt, col: int) -> *u8
extern "sqlite3_column_blob" column_blob(stmt: *Stmt, col: int) -> *u8
extern "sqlite3_column_bytes" column_bytes(stmt: *Stmt, col: int) -> int
extern "sqlite3_column_name" column_name(stmt: *Stmt, col: int) -> *u8
extern "sqlite3_column_decltype" column_decltype(stmt: *Stmt, col: int) -> *u8

// Binding a parameter. SQLite numbers them from 1.
//
// `bind_parameter_count` is the largest index the statement has, which is what a caller filling a
// statement from a list of values checks its length against rather than discovering one `SQLITE_RANGE`
// at a time. `clear_bindings` sets every parameter back to NULL, which `reset` deliberately does not.
extern "sqlite3_bind_int" bind_int(stmt: *Stmt, index: int, value: int) -> int
extern "sqlite3_bind_int64" bind_int64(stmt: *Stmt, index: int, value: long) -> int
extern "sqlite3_bind_double" bind_double(stmt: *Stmt, index: int, value: real) -> int
extern "sqlite3_bind_null" bind_null(stmt: *Stmt, index: int) -> int
extern "sqlite3_bind_parameter_count" bind_parameter_count(stmt: *Stmt) -> int
extern "sqlite3_clear_bindings" clear_bindings(stmt: *Stmt) -> int

// The two below are `shim.c`, not SQLite -- see that file for why `SQLITE_TRANSIENT` cannot be
// spelled here at all. They are the only things in the whole binding that C has to do on sysl's
// behalf, and they are the two that hand SQLite bytes it has to keep.
extern "sysl_sqlite_bind_text" bind_text(stmt: *Stmt, index: int, value: *u8) -> int
extern "sysl_sqlite_bind_blob" bind_blob(stmt: *Stmt, index: int, value: *u8, n: int) -> int
