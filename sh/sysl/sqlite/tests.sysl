module sh.sysl.sqlite
@tests

import sysl.fs.{exists, remove_file}
import sysl.time.monotonic

// The binding's own tests, run with `sysl test .` and against a real SQLite.
//
// Most of them open `:memory:`, which SQLite treats as a private database living for as long as the
// connection -- so there is no file to clean up and no order dependence between tests. The one that
// cannot use it is the one whose subject is what happens when there is no file, and it says so.
//
// **Nothing here closes a connection or finalizes a statement**, and that is the change these tests
// pin as much as anything they assert: both are destructors now, so a test that forgot one would leak
// rather than misbehave, and a test that called one would not compile.

private fresh() -> &Db
    open(":memory:") match
        Ok(db)   -> db
        Err(why) -> panic(f"could not open an in-memory database: ${why}%s")

// The defect this cursor exists for: `prepare` compiles the first statement of a piece of text and
// SQLite drops the rest with nothing said. That is not a failure and never was -- the tail pointer is
// how a caller reaches what is left, and the binding used to pass null for it.
@test("statements walks every statement in one piece of SQL")
statements_walks_all_of_them()
    val db = fresh()
    var walk = db.statements("CREATE TABLE a (x); INSERT INTO a VALUES (1); INSERT INTO a VALUES (2)")
    var seen = 0

    loop
        walk.next() match
            None -> break
            Some(q) ->
                q.step()
                seen += 1

    assert_eq(seen, 3, "three statements were compiled")
    assert(walk.error().is_none(), "and nothing was wrong with any of them")
end statements_walks_all_of_them

// The half that says the walk is not merely counting: the second statement has to have *run*, which is
// what the workaround it replaces could not get to.
@test("and running them all leaves what all of them did")
exec_all_runs_all_of_them()
    val db = fresh()

    assert_eq(db.exec_all("CREATE TABLE a (x); INSERT INTO a VALUES (1); INSERT INTO a VALUES (2)").unwrap(),
      3, "three statements ran")

    val q = db.prepare("SELECT count(*) FROM a").unwrap()

    assert(q.step().unwrap(), "the count is a row")
    assert_eq(q.int_at(0), 2, "and both inserts landed")
end exec_all_runs_all_of_them

// `exec` is unchanged, and this is what pins that: the same text through the one-statement form runs
// the CREATE and drops both inserts. It is SQLite's behaviour rather than a defect, and it is worth
// having written down beside the cursor so the difference between the two is a test rather than a
// sentence in a comment.
@test("while exec still runs the first statement and no more")
exec_is_still_one_statement()
    val db = fresh()

    assert(db.exec("CREATE TABLE a (x); INSERT INTO a VALUES (1)").is_ok(), "the CREATE ran")

    val q = db.prepare("SELECT count(*) FROM a").unwrap()

    assert(q.step().unwrap(), "the count is a row")
    assert_eq(q.int_at(0), 0, "and the INSERT after the semicolon did not")
end exec_is_still_one_statement

// Text that compiles to no statement at all is not the end of the walk. SQLite reports a run of
// semicolons, trailing whitespace or a comment as success with a null handle, which is a piece of text
// with nothing in it rather than an error -- so the cursor steps past it and asks again.
@test("empty pieces between statements are stepped over rather than ending the walk")
statements_skips_the_empty_pieces()
    val db = fresh()

    assert_eq(db.exec_all("CREATE TABLE a (x);; ; INSERT INTO a VALUES (1); -- and a comment\n").unwrap(),
      2, "two real statements, and the empty pieces are not counted")
end statements_skips_the_empty_pieces

// SQL that will not compile stops the walk and the message is asked for afterwards, because a cursor
// out of text and one that hit bad SQL both answer `None` from `next`.
@test("bad SQL stops the walk and is reported after it")
statements_reports_why_it_stopped()
    val db = fresh()
    var walk = db.statements("CREATE TABLE a (x); NOT SQL AT ALL")
    var seen = 0

    loop
        walk.next() match
            None -> break
            Some(q) ->
                q.step()
                seen += 1

    assert_eq(seen, 1, "the statement before the mistake compiled")

    walk.error() match
        None      -> panic("the walk should say why it stopped")
        Some(why) -> assert_eq(why.kind(), Failed, "SQL that will not compile is the unspecific code")
end statements_reports_why_it_stopped

// The count `exec_all` hands back with a failure is what actually ran, which is the honest number:
// there is no transaction here, so the first statement has run and stays run.
@test("exec_all stops at the first failure and says so")
exec_all_stops_at_the_first_failure()
    val db = fresh()

    assert(db.exec_all("CREATE TABLE a (x); NOT SQL AT ALL; INSERT INTO a VALUES (1)").is_err(),
      "the mistake is reported")

    val q = db.prepare("SELECT count(*) FROM a").unwrap()

    assert(q.step().unwrap(), "the table was made before the mistake")
    assert_eq(q.int_at(0), 0, "and nothing after it ran")
end exec_all_stops_at_the_first_failure

// A single statement through the cursor is one statement, so nothing about the ordinary case moved.
@test("one statement through the cursor is one statement")
statements_over_one_statement()
    val db = fresh()

    assert_eq(db.exec_all("CREATE TABLE a (x)").unwrap(), 1, "one ran")
    assert_eq(db.exec_all("").unwrap(), 0, "and empty text is a walk over nothing")
end statements_over_one_statement

// ## The codes
//
// `Code.of` reads the header of the machine being built for, so nothing here can check it against that
// header without asking the same question twice. What it can do is check it against the *numbers SQLite
// publishes*, which are interface rather than implementation: the result codes have had these values
// since version 3 and the documentation states them, so a build where `Code.of(5)` is not `Busy` has a
// header disagreeing with SQLite's own documentation.
@test("a code is the number SQLite documents for it")
codes_are_the_documented_numbers()
    assert_eq(Code.of(0), Success, "SQLITE_OK")
    assert_eq(Code.of(1), Failed, "SQLITE_ERROR")
    assert_eq(Code.of(5), Busy, "SQLITE_BUSY")
    assert_eq(Code.of(8), ReadOnly, "SQLITE_READONLY")
    assert_eq(Code.of(14), CantOpen, "SQLITE_CANTOPEN")
    assert_eq(Code.of(19), Constraint, "SQLITE_CONSTRAINT")
    assert_eq(Code.of(26), NotADb, "SQLITE_NOTADB")
    assert_eq(Code.of(100), Row, "SQLITE_ROW")
    assert_eq(Code.of(101), Done, "SQLITE_DONE")
end codes_are_the_documented_numbers

// A number SQLite has not given a primary code to is `Unknown` rather than a trap, which is what keeps
// a program running against a newer library than this binding was written for.
@test("a number the binding does not name is Unknown, and keeps its number")
an_unnamed_code_is_unknown()
    assert_eq(Code.of(1234), Unknown, "not a code this binding names")
    assert_eq(Error(1234, "whatever it was").kind(), Unknown, "and an error carrying it says so")
    assert_eq(Error(1234, "whatever it was").code, 1234, "while the number is still there to report")
end an_unnamed_code_is_unknown

// The reason `Code` exists at all: a caller can tell one failure from another without reading English.
// A duplicate primary key is `Constraint` -- not something waiting will fix, and not the same as the
// lock `Busy` reports.
@test("a constraint violation is reported as a constraint")
a_violation_is_a_constraint()
    val db = fresh()

    db.exec("CREATE TABLE a (x INTEGER PRIMARY KEY)").unwrap()
    db.exec("INSERT INTO a VALUES (1)").unwrap()

    db.exec("INSERT INTO a VALUES (1)") match
        Ok(_)    -> panic("the second insert should have been refused")
        Err(why) ->
            assert_eq(why.kind(), Constraint, "the schema refused it")
            assert_eq(why.code, 19, "which is SQLITE_CONSTRAINT")
            assert(why.message.len > 0, "and SQLite's own sentence came with it")
end a_violation_is_a_constraint

// The two failures SQLite has no opinion about are marked as this binding's rather than dressed up as
// the database's. Both are cases where SQLite reported success and handed over something unusable.
@test("a failure that is not SQLite's says so")
a_failure_of_our_own_is_marked()
    val db = fresh()

    db.prepare("-- nothing but a comment") match
        Ok(_)    -> panic("there is no statement in a comment")
        Err(why) ->
            assert_eq(why.kind(), NotSqlite, "SQLite reported success and gave a null statement")
            assert_eq(why.code, NOT_SQLITE, "which is the code reserved for this binding's own")
end a_failure_of_our_own_is_marked

// An error renders as SQLite's sentence and a code renders as the header's word for it, so a program
// that logs either prints something a reader can act on.
@test("an error prints its message and a code prints the header's name")
errors_and_codes_render()
    assert_eq(f"${Error(5, "database is locked")}%s", "database is locked", "the error is its message")
    assert_eq(f"${Busy}%s", "SQLITE_BUSY", "and a code is the header's own word")
end errors_and_codes_render

// ## Ownership
//
// The hazard this conversion removes: a statement that outlives the scope its connection was opened in.
// The `&Db` a `Query` holds is what makes it work, and there is nothing in the calling code that says
// so -- which is the point.
//
// **Stepping the statement is not enough to see it**, and that is worth knowing before trusting this
// pair. Take the reference away and `sqlite3_close` runs while the statement is live, which SQLite
// *refuses*: the call answers `SQLITE_BUSY`, closes nothing, and leaks the connection -- so the
// statement goes on working and a test that only stepped it would pass with the defect present. What
// cannot survive a closed connection is compiling a *new* statement on it, so that is what both tests
// here end with.
@test("a statement keeps its connection alive after the scope that opened it has gone")
a_query_outlives_the_scope_that_opened_the_database()
    val q = lingering()

    assert(q.step().unwrap(), "the statement still runs")
    assert_eq(q.int_at(0), 42, "against a connection nothing here is holding")

    val again = q.db.prepare("SELECT 43").unwrap()

    assert(again.step().unwrap(), "and the connection is open rather than merely unfreed")
    assert_eq(again.int_at(0), 43, "which a closed one could not have compiled")
end a_query_outlives_the_scope_that_opened_the_database

private lingering() -> &Query
    val db = fresh()

    db.prepare("SELECT 42").unwrap()

// The cursor holds the connection for the same reason, so a walk handed out of the function that opened
// the database is a walk over a database that is still open.
@test("and so does a cursor")
a_cursor_outlives_it_too()
    var walk = lingering_walk()
    var seen = 0

    loop
        walk.next() match
            None -> break
            Some(q) ->
                assert(q.step().unwrap(), "the row is there")
                seen += 1

    assert_eq(seen, 2, "both statements compiled and ran")
end a_cursor_outlives_it_too

private lingering_walk() -> Statements
    val db = fresh()

    db.statements("SELECT 1; SELECT 2")

// ## Binding parameters
//
// The statement comes back from a bind, so a call site chains rather than naming the statement once per
// parameter.
@test("bindings chain, and SQLite numbers them from 1")
bindings_chain()
    val db = fresh()

    db.exec("CREATE TABLE a (n, s)").unwrap()

    val ins = db.prepare("INSERT INTO a VALUES (?, ?)").unwrap()

    ins.bind_int(1, 7).unwrap().bind_text(2, "seven").unwrap().step().unwrap()

    val q = db.prepare("SELECT n, s FROM a").unwrap()

    assert(q.step().unwrap(), "the row is there")
    assert_eq(q.int_at(0), 7, "the integer arrived")
    assert_eq(q.text_at(1).unwrap().unwrap(), "seven", "and so did the text")
    assert_eq(q.columns(), 2, "two columns were selected")
    assert_eq(q.name_at(0).unwrap(), "n", "and the first is named as the table declares it")
end bindings_chain

// An index outside the statement's parameters is `Range`, which is a mistake in the calling program and
// worth being able to recognise as one.
@test("a parameter index the statement does not have is Range")
a_bad_index_is_range()
    val db = fresh()
    val q = db.prepare("SELECT ?").unwrap()

    q.bind_int(2, 1) match
        Ok(_)    -> panic("there is only one parameter")
        Err(why) -> assert_eq(why.kind(), Range, "SQLITE_RANGE")
end a_bad_index_is_range

// SQL NULL and a value are different answers from `text_at`, and neither is an error.
@test("a NULL text column is None rather than a failure")
null_text_is_none()
    val db = fresh()

    db.exec_all("CREATE TABLE a (s); INSERT INTO a VALUES (NULL); INSERT INTO a VALUES ('here')").unwrap()

    val q = db.prepare("SELECT s FROM a ORDER BY rowid").unwrap()

    assert(q.step().unwrap(), "the first row")
    assert(q.text_at(0).unwrap().is_none(), "which is SQL NULL")

    assert(q.step().unwrap(), "the second row")
    assert_eq(q.text_at(0).unwrap().unwrap(), "here", "which is a value")
end null_text_is_none

// Resetting keeps the compiled SQL and its bindings, which is what makes a prepared statement worth
// preparing.
@test("a statement runs again after a reset")
reset_runs_it_again()
    val db = fresh()

    db.exec("CREATE TABLE a (x)").unwrap()

    val ins = db.prepare("INSERT INTO a VALUES (?)").unwrap()

    ins.bind_int(1, 1).unwrap().step().unwrap()
    ins.reset().unwrap().bind_int(1, 2).unwrap().step().unwrap()

    val q = db.prepare("SELECT count(*) FROM a").unwrap()

    assert(q.step().unwrap(), "the count is a row")
    assert_eq(q.int_at(0), 2, "the same statement ran twice")
end reset_runs_it_again

// ## Access
//
// **This is the test the binding could not have had**, because creating the file and opening it for
// writing were one hard-coded number in C until the flags came from the header. `Write` is the
// combination that was unreachable, and a missing file is the only way to see the difference.
//
// It is the one test here that touches the file system, so it removes the file first rather than
// trusting the last run to have finished tidily.
@test("Write opens a database that is there and refuses one that is not")
access_tells_creating_from_opening()
    val path = "/tmp/sysl-sqlite-access-probe.db"

    if exists(path) then remove_file(path).unwrap()

    open_with(path, Write) match
        Ok(_)    -> panic("there is no file, and Write does not make one")
        Err(why) -> assert_eq(why.kind(), CantOpen, "SQLITE_CANTOPEN")

    assert(!exists(path), "and nothing was created by the attempt")

    open_with(path, Create).unwrap().exec("CREATE TABLE a (x)").unwrap()

    assert(exists(path), "Create made the file")

    // The same call that failed a moment ago, against the same path.
    assert(open_with(path, Write).unwrap().exec("INSERT INTO a VALUES (1)").is_ok(),
      "and now writes to what is there")

    // A read-only connection opens it and refuses to write to it.
    val ro = open_readonly(path).unwrap()

    assert(ro.exec("SELECT count(*) FROM a").is_ok(), "reading is what it is for")

    ro.exec("INSERT INTO a VALUES (2)") match
        Ok(_)    -> panic("a read-only connection should refuse a write")
        Err(why) -> assert_eq(why.kind(), ReadOnly, "SQLITE_READONLY")

    remove_file(path).unwrap()
end access_tells_creating_from_opening

// ## Values
//
// SQLite has five storage classes and this is where each of them is bound and read back. The subject
// of most of what follows is the difference between what a *column* was declared as and what a *value*
// turned out to be, because SQLite keeps them apart and a program mapping rows onto a language's own
// values has to keep them apart too.

// `Buf.view()` answers a `[]u8` and a fixture is a `[]const u8`; the two are different types and
// deliberately so, and a parameter is where they meet.
private same(got: []const u8, want: []const u8, what: string = "bytes differ") =
    assert_eq(got, want, what)

// Bytes chosen so that nothing about them survives being treated as text: a leading zero, an interior
// zero, a trailing zero, and a byte that is not valid UTF-8 on its own.
private embedded_zeros() -> []const u8 = [0, 1, 0, 255, 0]

// One row holding one value of every storage class, which is the whole of what SQLite can store. A
// program with a value model of its own has an arm for each of these and needs nothing else.
@test("every storage class binds and reads back as what it was")
every_storage_class_round_trips()
    val db = fresh()

    db.exec("CREATE TABLE v (i, l, r, t, b, n)").unwrap()

    val ins = db.prepare("INSERT INTO v VALUES (?, ?, ?, ?, ?, ?)").unwrap()

    ins.bind_int(1, 7).unwrap().bind_long(2, 4294967296i64).unwrap().bind_real(3, 0.5).unwrap()
      .bind_text(4, "seven").unwrap().bind_blob(5, embedded_zeros()).unwrap().bind_null(6).unwrap()
      .step().unwrap()

    val q = db.prepare("SELECT i, l, r, t, b, n FROM v").unwrap()

    assert(q.step().unwrap(), "the row is there")

    assert_eq(q.type_at(0), Integer, "an int is stored as an integer")
    assert_eq(q.int_at(0), 7, "and reads back")

    assert_eq(q.type_at(1), Integer, "so is a long")
    assert_eq(q.long_at(1), 4294967296i64, "at its full width")

    assert_eq(q.type_at(2), Real, "a double is SQLITE_FLOAT")
    assert_eq(q.real_at(2), 0.5, "and reads back exactly")

    assert_eq(q.type_at(3), Text, "text is text")
    assert_eq(q.text_at(3).unwrap().unwrap(), "seven", "and reads back")

    assert_eq(q.type_at(4), Blob, "bytes are a blob")
    same(q.blob_at(4).unwrap().view(), embedded_zeros(), "and every one of them came back")

    assert_eq(q.type_at(5), Null, "and a bound NULL is SQL NULL")
    assert(q.text_at(5).unwrap().is_none(), "which text_at reports as an absence")
end every_storage_class_round_trips

// The reason `long_at` and `bind_long` exist beside the `int` pair: SQLite stores an integer in up to
// 64 bits and `sqlite3_column_int` keeps 32 of them. 2^32 is the smallest value where the difference is
// visible, and the narrow reader answers zero rather than anything that looks wrong.
@test("a 64-bit integer survives, where the 32-bit reader would truncate it")
long_values_are_not_truncated()
    val db = fresh()

    db.exec("CREATE TABLE t (v)").unwrap()

    val ins = db.prepare("INSERT INTO t VALUES (?)").unwrap()

    ins.bind_long(1, 4294967296i64).unwrap().step().unwrap()

    val q = db.prepare("SELECT v FROM t").unwrap()

    assert(q.step().unwrap(), "the row is there")
    assert_eq(q.long_at(0), 4294967296i64, "read whole")
    assert_eq(q.int_at(0), 0, "while the 32-bit reader keeps only the low half, which is all zeros")
end long_values_are_not_truncated

// A blob carries its length, so a zero byte is a byte rather than the end. This is the difference a
// program storing anything that is not text depends on, and a `bind_text` of the same bytes would have
// stopped at the first one.
@test("a blob round-trips through bytes that include zero")
blobs_carry_zero_bytes()
    val db = fresh()

    db.exec("CREATE TABLE b (v)").unwrap()

    val ins = db.prepare("INSERT INTO b VALUES (?)").unwrap()

    ins.bind_blob(1, embedded_zeros()).unwrap().step().unwrap()

    val q = db.prepare("SELECT v, length(v) FROM b").unwrap()

    assert(q.step().unwrap(), "the row is there")
    assert_eq(q.type_at(0), Blob, "stored as a blob")
    same(q.blob_at(0).unwrap().view(), embedded_zeros(), "and every byte came back")
    assert_eq(q.int_at(1), 5, "including the three zeros, which text would have ended at")
end blobs_carry_zero_bytes

// An empty value and no value are different, and SQLite's C API loses the difference at BOTH ends --
// which is why this test is here and why it failed the first time it was run.
//
// Reading, `sqlite3_column_blob` answers a null pointer for a zero-length blob *and* for SQL NULL, so
// a null check alone reports an empty value as no value; only the storage class tells them apart, and
// `blob_at` asks for it first. Writing, a null pointer handed to `sqlite3_bind_blob` *is*
// `sqlite3_bind_null` -- the length is ignored -- and sysl's `as_ptr` answers null for an empty slice,
// so `bind_blob(i, [])` stored SQL NULL until the shim started substituting a byte SQLite will not
// read.
@test("a zero-length blob is a value, and SQL NULL is not")
an_empty_blob_is_not_null()
    val db = fresh()

    db.exec("CREATE TABLE b (v)").unwrap()

    val ins = db.prepare("INSERT INTO b VALUES (?)").unwrap()

    ins.bind_blob(1, []).unwrap().step().unwrap()
    ins.reset().unwrap().bind_null(1).unwrap().step().unwrap()

    val q = db.prepare("SELECT v FROM b ORDER BY rowid").unwrap()

    assert(q.step().unwrap(), "the empty blob")
    assert_eq(q.type_at(0), Blob, "which is a blob")
    assert(q.blob_at(0).is_some(), "and a value, though SQLite's pointer for it is null")
    assert_eq(q.blob_at(0).unwrap().len(), 0, "with nothing in it")

    assert(q.step().unwrap(), "and then SQL NULL")
    assert_eq(q.type_at(0), Null, "which is not a blob")
    assert(q.blob_at(0).is_none(), "and is the absence of a value")
end an_empty_blob_is_not_null

// **Every reader coerces and none of them refuses**, which is SQLite's rule and not this binding's. It
// is written down as a test rather than as a sentence because it is the behaviour a caller is most
// likely to mistake for a bug: nothing anywhere reports that the column held something else.
@test("reading a column as the wrong type is SQLite's coercion rather than a failure")
readers_coerce_and_never_object()
    val db = fresh()

    db.exec("CREATE TABLE t (v)").unwrap()
    db.exec_all("INSERT INTO t VALUES ('3.5'); INSERT INTO t VALUES ('apple')").unwrap()
    db.exec_all("INSERT INTO t VALUES (42); INSERT INTO t VALUES (NULL)").unwrap()

    val q = db.prepare("SELECT v FROM t ORDER BY rowid").unwrap()

    assert(q.step().unwrap(), "the text '3.5'")
    assert_eq(q.type_at(0), Text, "stored as text")
    assert_eq(q.int_at(0), 3, "which reads as a number by truncation")
    assert_eq(q.real_at(0), 3.5, "or as a double, exactly")

    assert(q.step().unwrap(), "the text 'apple'")
    assert_eq(q.int_at(0), 0, "which is not a number at all, and is 0 rather than an error")
    assert_eq(q.type_at(0), Text, "so 0 and a stored zero are told apart only here")

    assert(q.step().unwrap(), "the integer 42")
    assert_eq(q.type_at(0), Integer, "stored as an integer")
    assert_eq(q.text_at(0).unwrap().unwrap(), "42", "and read back as its decimal spelling")

    assert(q.step().unwrap(), "and SQL NULL")
    assert_eq(q.type_at(0), Null, "which type_at names")
    assert_eq(q.int_at(0), 0, "while the numeric readers answer 0, a value and not a signal")
    assert_eq(q.real_at(0), 0.0, "both of them")
    assert(q.text_at(0).unwrap().is_none(), "and only text_at reports the absence on its own")
end readers_coerce_and_never_object

// The declared type and the storage class are two different questions, and a row is where they
// disagree: a column declared INTEGER holds the text that would not convert to one.
@test("type_at is the value's question and decltype_at is the schema's")
declared_types_are_not_storage_classes()
    val db = fresh()

    db.exec_all("CREATE TABLE t (n INTEGER, s VARCHAR(20)); INSERT INTO t VALUES ('not a number', 'five')").unwrap()

    val q = db.prepare("SELECT n, s, count(*) FROM t").unwrap()

    assert(q.step().unwrap(), "the row is there")

    assert_eq(q.decltype_at(0).unwrap(), "INTEGER", "the schema's word for the first column")
    assert_eq(q.type_at(0), Text, "over a value that is nothing of the kind")

    assert_eq(q.decltype_at(1).unwrap(), "VARCHAR(20)", "the declaration verbatim, parentheses and all")

    assert(q.decltype_at(2).is_none(), "while a count is an expression and has no declaration to read")
    assert_eq(q.name_at(2).unwrap(), "count(*)", "though it still has a name")
end declared_types_are_not_storage_classes

// ## Binding, and the error path every bind shares

// An index outside the statement's parameters is `Range` for all six of them, which is a mistake in the
// calling program and worth recognising as one rather than discovering a NULL in the row afterwards.
@test("every bind refuses an index the statement does not have")
every_bind_reports_range()
    val db = fresh()
    val q = db.prepare("SELECT ?").unwrap()

    assert_eq(q.bind_int(2, 1).unwrap_err().kind(), Range, "bind_int")
    assert_eq(q.bind_long(2, 1i64).unwrap_err().kind(), Range, "bind_long")
    assert_eq(q.bind_real(2, 1.0).unwrap_err().kind(), Range, "bind_real")
    assert_eq(q.bind_text(2, "x").unwrap_err().kind(), Range, "bind_text")
    assert_eq(q.bind_blob(2, embedded_zeros()).unwrap_err().kind(), Range, "bind_blob")
    assert_eq(q.bind_null(2).unwrap_err().kind(), Range, "bind_null")

    assert_eq(q.bind_null(0).unwrap_err().kind(), Range, "and 0, since SQLite numbers parameters from 1")
end every_bind_reports_range

// `parameters` is what a caller filling a statement from a list checks its length against, and
// `clear_bindings` is the half of reuse that `reset` deliberately leaves undone.
@test("parameters counts what the statement has, and clear_bindings is what reset does not do")
parameter_count_and_clearing()
    val db = fresh()

    db.exec("CREATE TABLE t (a, b)").unwrap()

    val ins = db.prepare("INSERT INTO t VALUES (?, ?)").unwrap()

    assert_eq(ins.parameters(), 2, "two parameters, as the SQL wrote them")
    assert_eq(db.prepare("SELECT 1").unwrap().parameters(), 0, "and none where there are none")

    ins.bind_int(1, 1).unwrap().bind_int(2, 2).unwrap().step().unwrap()
    ins.reset().unwrap().step().unwrap()
    ins.reset().unwrap().clear_bindings().unwrap().step().unwrap()

    val q = db.prepare("SELECT a, b FROM t ORDER BY rowid").unwrap()

    assert(q.step().unwrap(), "the first row")
    assert_eq(q.int_at(0), 1, "as it was bound")

    assert(q.step().unwrap(), "the second")
    assert_eq(q.int_at(0), 1, "which a reset alone carried across")

    assert(q.step().unwrap(), "and the third")
    assert_eq(q.type_at(0), Null, "where clear_bindings left NULL")
    assert_eq(q.type_at(1), Null, "in every parameter rather than the one")
end parameter_count_and_clearing

// ## What the connection has to say afterwards

@test("last_insert_rowid names the row just inserted, and changes counts what a statement touched")
the_connection_reports_what_it_did()
    val db = fresh()

    db.exec("CREATE TABLE t (id INTEGER PRIMARY KEY, v)").unwrap()

    assert_eq(db.last_insert_rowid(), 0i64, "nothing has been inserted on this connection yet")

    db.exec("INSERT INTO t (v) VALUES ('a')").unwrap()

    assert_eq(db.last_insert_rowid(), 1i64, "the key SQLite chose, which the caller did not")
    assert_eq(db.changes(), 1, "one row went in")

    db.exec("INSERT INTO t (v) VALUES ('b')").unwrap()

    assert_eq(db.last_insert_rowid(), 2i64, "and the next one")

    db.exec("UPDATE t SET v = 'c'").unwrap()

    assert_eq(db.changes(), 2, "an UPDATE with no WHERE touched both rows")

    db.exec("DELETE FROM t WHERE v = 'nothing matches this'").unwrap()

    assert_eq(db.changes(), 0, "and a statement that matched nothing is 0 rather than an error")
    assert_eq(db.last_insert_rowid(), 2i64, "while the last key stands, a DELETE not having made one")
end the_connection_reports_what_it_did

// ## Transactions

@test("a transaction either all happens or none of it does")
transactions_commit_and_roll_back()
    val db = fresh()

    db.exec("CREATE TABLE t (x)").unwrap()

    assert(!db.in_transaction(), "nothing is open to begin with")

    db.begin().unwrap()

    assert(db.in_transaction(), "and now something is")

    db.exec("INSERT INTO t VALUES (1)").unwrap()
    db.rollback().unwrap()

    assert(!db.in_transaction(), "the rollback closed it")
    assert_eq(rows_in(db), 0, "and undid the insert")

    db.begin().unwrap()
    db.exec("INSERT INTO t VALUES (2)").unwrap()
    db.commit().unwrap()

    assert(!db.in_transaction(), "the commit closed it too")
    assert_eq(rows_in(db), 1, "and what was committed stayed")
end transactions_commit_and_roll_back

private rows_in(db: &Db) -> int
    val q = db.prepare("SELECT count(*) FROM t").unwrap()

    q.step().unwrap()
    q.int_at(0)

// The error path of the pair: SQLite has no nested transactions, so a second `begin` is refused rather
// than counted. `in_transaction` is how a caller that might be inside one already asks first.
@test("a transaction inside a transaction is refused")
transactions_do_not_nest()
    val db = fresh()

    db.begin().unwrap()

    db.begin() match
        Ok(_)    -> panic("SQLite has no nested transactions")
        Err(why) ->
            assert_eq(why.kind(), Failed, "the unspecific code, with the interesting part in the message")
            assert(why.message.len > 0, "which SQLite supplied")

    assert(db.in_transaction(), "and the one that was open is still open")

    db.rollback().unwrap()

    db.rollback() match
        Ok(_)    -> panic("there is nothing left to roll back")
        Err(why) -> assert_eq(why.kind(), Failed, "so a second rollback is refused as well")
end transactions_do_not_nest

// `busy_timeout` is the answer to `Busy` for a program that has no better one. Two connections to one
// file is the only way to see it, so this is the second test here that touches the file system.
//
// **The wait is what is asserted, not the answer**, because the answer is `Busy` either way: the other
// connection never lets go. What changes is that the second attempt does not come back at once.
@test("busy_timeout is how long a locked database is waited for")
busy_timeout_waits_before_giving_up()
    val path = "/tmp/sysl-sqlite-busy-probe.db"

    if exists(path) then remove_file(path).unwrap()

    val holder = open(path).unwrap()

    holder.exec("CREATE TABLE t (x)").unwrap()

    val waiter = open(path).unwrap()

    holder.exec("BEGIN IMMEDIATE").unwrap()

    waiter.exec("BEGIN IMMEDIATE") match
        Ok(_)    -> panic("the other connection is holding the write lock")
        Err(why) -> assert_eq(why.kind(), Busy, "and with no timeout the refusal is immediate")

    waiter.busy_timeout(300).unwrap()

    val started = monotonic().us

    waiter.exec("BEGIN IMMEDIATE") match
        Ok(_)    -> panic("the lock is still held")
        Err(why) -> assert_eq(why.kind(), Busy, "so the answer is the same one")

    assert(monotonic().us - started >= 250000i64, "but it waited for it rather than answering at once")

    holder.exec("ROLLBACK").unwrap()

    assert(waiter.exec("BEGIN IMMEDIATE").is_ok(), "and once the lock is let go the write proceeds")

    waiter.exec("ROLLBACK").unwrap()
    remove_file(path).unwrap()
end busy_timeout_waits_before_giving_up

// ## What this SQLite was built with
//
// SQLite is the machine's library rather than one this package carries, so what it can do is a property
// of the machine. FTS5 is the case worth checking, since a program that means to use it otherwise finds
// out at the `CREATE VIRTUAL TABLE`, which fails with the unspecific code and "no such module: fts5".
@test("this SQLite has FTS5, and either spelling of an option name asks the same question")
fts5_is_compiled_in()
    assert(compiled_with("ENABLE_FTS5"), "SQLITE_ENABLE_FTS5 was set when this library was built")
    assert(compiled_with("SQLITE_ENABLE_FTS5"), "and the SQLITE_ prefix is optional rather than wrong")
    assert(!compiled_with("ENABLE_NOTHING_OF_THE_SORT"), "while an option nobody has is simply false")
end fts5_is_compiled_in

// The claim the check above makes, made again by using it: a full-text table, a match, and the score
// read as the double it is. `bm25()` and the hidden `rank` column are the same number, and both are
// negative because FTS5 orders a better match first by making it smaller.
@test("a full-text search runs and its bm25 rank reads as a double")
fts5_ranks_are_doubles()
    val db = fresh()

    db.exec("CREATE VIRTUAL TABLE docs USING fts5(body)").unwrap()
    db.exec_all("INSERT INTO docs VALUES ('the quick brown fox'); INSERT INTO docs VALUES ('a turtle')").unwrap()

    val q = db.prepare("SELECT body, bm25(docs), rank FROM docs WHERE docs MATCH 'fox' ORDER BY rank").unwrap()

    assert(q.step().unwrap(), "the matching document")
    assert_eq(q.text_at(0).unwrap().unwrap(), "the quick brown fox", "which is the one with the word in it")
    assert_eq(q.type_at(1), Real, "bm25 answers a double")
    assert(q.real_at(1) < 0.0, "and a better match is a more negative number, which is FTS5's convention")
    assert_eq(q.real_at(2), q.real_at(1), "while rank is that same score under another name")

    assert(!q.step().unwrap(), "and nothing else matched")
end fts5_ranks_are_doubles
